@startuml
hide circle
hide stereotype
hide members
hide methods
skinparam linetype ortho
skinparam class {
BackgroundColor<<LogicalModel>> #APPLICATION
BackgroundColor<<Profile>> #TECHNOLOGY
}
legend right
| <#APPLICATION>  Logical Model |
| <#TECHNOLOGY>  Profile |
endlegend
class "Shared Health Record" <<LogicalModel>> [[StructureDefinition-HeaderSzzCz.html]]

class "cz-organization-core" <<Profile>> [[https://build.fhir.org/ig/HL7-cz/cz-core/StructureDefinition-cz-organization-core.html]]
class "cz-patient-core" <<Profile>> [[https://build.fhir.org/ig/HL7-cz/cz-core/StructureDefinition-cz-patient-core.html]]
class "cz-practitioner-core" <<Profile>> [[https://build.fhir.org/ig/HL7-cz/cz-core/StructureDefinition-cz-practitioner-core.html]]
class "cz-bundle-sharedhealthrecord" <<Profile>> [[StructureDefinition-cz-bundle-sharedhealthrecord.html]]
class "cz-composition-sharedhealthrecord" <<Profile>> [[StructureDefinition-cz-composition-sharedhealthrecord.html]]
class "cz-provenance" <<Profile>> [[https://build.fhir.org/ig/HL7-cz/cz-core/StructureDefinition-cz-provenance.html]]

"Shared Health Record" <|. "cz-composition-sharedhealthrecord"
"Shared Health Record" <|. "cz-bundle-sharedhealthrecord"
"Shared Health Record" <|. "cz-patient-core"
"Shared Health Record" <|. "cz-practitioner-core"
"Shared Health Record" <|. "cz-organization-core"
"Shared Health Record" <|. "cz-provenance"

"cz-bundle-sharedhealthrecord" -d[hidden]-> "cz-composition-sharedhealthrecord"
"cz-composition-sharedhealthrecord" -d[hidden]-> "cz-patient-core"
"cz-patient-core" -d[hidden]-> "cz-practitioner-core"
"cz-practitioner-core" -d[hidden]-> "cz-organization-core"
"cz-organization-core" -d[hidden]-> "cz-provenance"
@enduml
